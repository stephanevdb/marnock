{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marnock.local/schemas/messages.json",
  "title": "MarnockMessages",
  "definitions": {
    "PairHello": {
      "type": "object",
      "required": ["deviceId", "publicKey", "pairingCode", "displayName", "platform"],
      "properties": {
        "deviceId": { "type": "string" },
        "publicKey": { "type": "string", "description": "base64 X25519 public key" },
        "pairingCode": { "type": "string" },
        "displayName": { "type": "string" },
        "platform": { "enum": ["android", "macos"] }
      }
    },
    "PairComplete": {
      "type": "object",
      "required": ["deviceId", "ok"],
      "properties": {
        "deviceId": { "type": "string" },
        "ok": { "type": "boolean" }
      }
    },
    "SessionFrame": {
      "type": "object",
      "required": ["nonce", "ciphertext"],
      "properties": {
        "nonce": { "type": "string" },
        "ciphertext": { "type": "string" }
      }
    },
    "ClipboardSet": {
      "type": "object",
      "required": ["text", "originDeviceId", "ts"],
      "properties": {
        "text": { "type": "string" },
        "originDeviceId": { "type": "string" },
        "ts": { "type": "integer" }
      }
    },
    "NotificationPosted": {
      "type": "object",
      "required": ["key", "packageName", "title", "text", "ts"],
      "properties": {
        "key": { "type": "string" },
        "packageName": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "ts": { "type": "integer" },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "allowsReply": { "type": "boolean" }
            }
          }
        }
      }
    },
    "NotificationRemoved": {
      "type": "object",
      "required": ["key"],
      "properties": { "key": { "type": "string" } }
    },
    "NotificationAction": {
      "type": "object",
      "required": ["key", "actionId"],
      "properties": {
        "key": { "type": "string" },
        "actionId": { "type": "string" },
        "replyText": { "type": "string" }
      }
    },
    "SmsThread": {
      "type": "object",
      "required": ["threadId", "address", "snippet", "date"],
      "properties": {
        "threadId": { "type": "string" },
        "address": { "type": "string" },
        "contactName": { "type": "string" },
        "snippet": { "type": "string" },
        "date": { "type": "integer" },
        "unread": { "type": "integer" }
      }
    },
    "SmsMessage": {
      "type": "object",
      "required": ["id", "threadId", "address", "body", "date", "type"],
      "properties": {
        "id": { "type": "string" },
        "threadId": { "type": "string" },
        "address": { "type": "string" },
        "body": { "type": "string" },
        "date": { "type": "integer" },
        "type": { "enum": ["inbox", "sent", "draft", "other"] }
      }
    },
    "SmsSend": {
      "type": "object",
      "required": ["address", "body", "requestId"],
      "properties": {
        "address": { "type": "string" },
        "body": { "type": "string" },
        "requestId": { "type": "string" }
      }
    },
    "CallState": {
      "type": "object",
      "required": ["state", "ts"],
      "properties": {
        "state": { "enum": ["idle", "ringing", "offhook", "dialing"] },
        "number": { "type": "string" },
        "name": { "type": "string" },
        "ts": { "type": "integer" }
      }
    },
    "CallHistoryEntry": {
      "type": "object",
      "required": ["id", "number", "date", "duration", "type"],
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "integer" },
        "duration": { "type": "integer" },
        "type": { "enum": ["incoming", "outgoing", "missed", "rejected", "other"] }
      }
    },
    "CallDial": {
      "type": "object",
      "required": ["number"],
      "properties": { "number": { "type": "string" } }
    },
    "RelayRegister": {
      "type": "object",
      "required": ["deviceId", "authToken"],
      "properties": {
        "deviceId": { "type": "string" },
        "authToken": { "type": "string" }
      }
    },
    "RelayForward": {
      "type": "object",
      "required": ["toDeviceId", "ciphertext"],
      "properties": {
        "toDeviceId": { "type": "string" },
        "ciphertext": { "type": "string" },
        "fromDeviceId": { "type": "string" }
      }
    },
    "FileOffer": {
      "type": "object",
      "required": ["transferId", "name", "size"],
      "properties": {
        "transferId": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "integer" },
        "mime": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "FileAccept": {
      "type": "object",
      "required": ["transferId", "ok"],
      "properties": {
        "transferId": { "type": "string" },
        "ok": { "type": "boolean" }
      }
    },
    "FileChunk": {
      "type": "object",
      "required": ["transferId", "offset", "data"],
      "properties": {
        "transferId": { "type": "string" },
        "offset": { "type": "integer" },
        "data": { "type": "string", "description": "base64 chunk" }
      }
    },
    "FileComplete": {
      "type": "object",
      "required": ["transferId"],
      "properties": {
        "transferId": { "type": "string" },
        "ok": { "type": "boolean" }
      }
    },
    "FileCancel": {
      "type": "object",
      "required": ["transferId"],
      "properties": { "transferId": { "type": "string" } }
    },
    "MediaCommand": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "enum": ["play", "pause", "next", "previous", "volume"] },
        "level": { "type": "integer" }
      }
    },
    "MediaState": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "playing": { "type": "boolean" },
        "volume": { "type": "integer" }
      }
    },
    "FindRing": {
      "type": "object",
      "properties": { "durationSec": { "type": "integer" } }
    },
    "FindStop": {
      "type": "object",
      "properties": {}
    },
    "DeviceStatus": {
      "type": "object",
      "properties": {
        "battery": { "type": "integer" },
        "charging": { "type": "boolean" },
        "wifiSsid": { "type": "string" },
        "cellular": { "type": "boolean" },
        "hotspotActive": { "type": "boolean" }
      }
    },
    "LinkOpen": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "originDeviceId": { "type": "string" }
      }
    },
    "WifiRequest": {
      "type": "object",
      "properties": {}
    },
    "WifiInfo": {
      "type": "object",
      "properties": {
        "ssid": { "type": "string" },
        "hasPassword": { "type": "boolean" },
        "password": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "PhotosListRequest": {
      "type": "object",
      "properties": { "limit": { "type": "integer" } }
    },
    "PhotosList": {
      "type": "object",
      "required": ["photos"],
      "properties": {
        "photos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "thumbB64": { "type": "string" }
            }
          }
        }
      }
    },
    "PhotosGet": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string" } }
    },
    "PrefsQuiet": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
